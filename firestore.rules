rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 파트너 컬렉션
    match /partners/{document} {
      // 코드 검증 및 관리자 조회를 위해 읽기 허용
      allow read: if true;

      // 신규 파트너 신청: WAITING 상태, code null, 필수 필드 존재만 허용
      allow create: if request.resource.data.status == 'WAITING'
                    && request.resource.data.code == null
                    && request.resource.data.academyName is string
                    && request.resource.data.phone is string;

      // 관리자 승인/정보 수정 (Firebase Auth 미사용으로 서버 구분 불가)
      allow update: if true;

      // 삭제 금지 (클라이언트에서 삭제 불가)
      allow delete: if false;
    }

    // 주문 컬렉션
    match /orders/{document} {
      // 파트너 주문 조회 및 관리자 조회를 위해 읽기 허용
      allow read: if true;

      // 신규 주문 생성: NEW 상태, 필수 필드 존재만 허용
      allow create: if request.resource.data.status == 'NEW'
                    && request.resource.data.partnerId is string
                    && request.resource.data.academyName is string;

      // 관리자 상태/가격/시안 업데이트
      allow update: if true;

      // 삭제 금지
      allow delete: if false;
    }
  }
}
